# API (см. app.config.ts)
# API_URL=http://localhost:3000/api/v1
# WS_URL=ws://localhost:3000/ws

# EAS cloud build: preview/production профили задают APP_ENV=production в eas.json.
# Локально для prod-like сборки: APP_ENV=production
# APP_ENV=production

# Google Sign-In (OAuth 2.0 Client IDs из Google Cloud Console)
# Web Client ID обязателен; iOS/Android — для нативных сборок
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Yandex MapKit Mobile SDK. Ключ читает app.config.ts и зашивает в нативную сборку.
# Для EAS положить то же имя в secrets. Expo Go карту не откроет — нужен dev build.
YANDEX_MAPKIT_API_KEY=

# Dev: сбросить онбординг при старте
# EXPO_PUBLIC_RESET_ONBOARDING=true
